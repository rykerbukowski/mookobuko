---
const facts = [
  { emoji: '🍜', text: 'Kewpie Mayo celebrated its 101st birthday' },
  { emoji: '🐛', text: 'We survived a mob-run bed bug hotel in Taichung' },
  { emoji: '🧗', text: 'Watched Alex Honnold free solo Taipei 101' },
  { emoji: '♨️', text: 'Black onsen water = soul cleansing' },
  { emoji: '🍞', text: 'Japanese toast appreciation society (est. 2026)' },
  { emoji: '🎿', text: 'Sapporo powder was absolutely unreal' },
  { emoji: '🍺', text: 'Sapporo Beer Museum: we "researched" extensively' },
  { emoji: '🥟', text: 'Din Tai Fung chocolate dumplings changed us' },
  { emoji: '🐘', text: 'A baby elephant tried to sit in Meg\'s lap' },
  { emoji: '🥊', text: 'Ryker\'s Muay Thai arc: zero to slightly dangerous' },
  { emoji: '🦈', text: 'Swam with a whale shark and lived to blog about it' },
  { emoji: '🎤', text: 'A Filipino woman sang Adele better than Adele' },
  { emoji: '🏍️', text: 'Miles crashed a Surron doing wheelies. Shocking.' },
  { emoji: '✈️', text: 'Geocached inside a 1971 plane crash in the ocean' },
  { emoji: '🤢', text: 'Bali gave us E. Coli and we still call it a win' },
  { emoji: '🏄', text: 'Surfed in literal sewage water. Would not recommend.' },
  { emoji: '💉', text: 'Two IV drips, one surf camp, zero regrets' },
  { emoji: '🇬🇧', text: '"Carnage" is now a permanent part of Meg\'s vocabulary' },
  { emoji: '🦇', text: 'Deer Cave fits 40 Boeing 747s inside its mouth' },
  { emoji: '🕷️', text: 'Meg vs. tarantula: tarantula won' },
  { emoji: '💳', text: '90k Marriott points = 1 week of five-star jungle living' },
  { emoji: '💻', text: 'Ryker almost left the laptop on the plane. Almost.' },
  { emoji: '🚲', text: 'Biked 435 miles across Japan and Korea' },
  { emoji: '🍷', text: 'Georgian wine has been made for 8,000 years and it shows' },
  { emoji: '🇬🇷', text: 'Island life activated: Aegina edition' },
];
---

<section class="ticker-section">
  <div class="ticker">
    {[...facts, ...facts].map((fact, i) => (
      <div class="ticker-item">
        <span class="emoji">{fact.emoji}</span>
        {fact.text}
      </div>
    ))}
  </div>
</section>

<style>
  .ticker-section {
    padding: 2rem 0;
    background: var(--ink);
    overflow: hidden;
  }

  .ticker {
    display: flex;
    animation: ticker 60s linear infinite;
    white-space: nowrap;
  }

  .ticker-item {
    flex-shrink: 0;
    padding: 0 3rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .emoji { font-size: 1.3rem; }

  .ticker-item:nth-child(odd) { color: var(--sunflower); }
  .ticker-item:nth-child(even) { color: var(--teal); }

  @keyframes ticker {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
</style>
