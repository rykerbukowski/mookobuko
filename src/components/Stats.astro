---
const stats = [
  { number: 0, label: 'Days on the road', color: 'var(--hot-pink)', id: 'days-counter' },
  { number: 12, label: 'Flights', color: 'var(--coral)' },
  { number: 8, label: 'Countries', color: 'var(--teal)' },
  { number: 19088, label: 'Miles traveled', color: 'var(--sunflower)' },
  { number: 16, label: 'Mangos eaten', color: 'var(--lime)' },
];
---

<section class="stats-section" id="stats">
  <div class="stats-grid" id="stats-grid">
    {stats.map(stat => (
      <div class="stat-item">
        <div class="stat-number" style={`color:${stat.color};`} data-target={stat.number} id={stat.id || ''}>0</div>
        <div class="stat-label">{stat.label}</div>
      </div>
    ))}
  </div>
</section>

<script is:inline>
  // Calculate days since Jan 5 2026
  var tripStart = new Date(2026, 0, 5); // Jan 5 2026
  var now = new Date();
  var days = Math.floor((now - tripStart) / (1000 * 60 * 60 * 24));
  var daysEl = document.getElementById("days-counter");
  if (daysEl) daysEl.dataset.target = days;

  var counterObserver = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) {
        entry.target.querySelectorAll('.stat-number').forEach(function(counter) {
          var target = parseInt(counter.dataset.target);
          var duration = 2000;
          var start = performance.now();
          function update(now) {
            var progress = Math.min((now - start) / duration, 1);
            var eased = 1 - Math.pow(1 - progress, 3);
            counter.textContent = Math.round(target * eased).toLocaleString();
            if (progress < 1) requestAnimationFrame(update);
          }
          requestAnimationFrame(update);
        });
        counterObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.5 });

  var statsGrid = document.getElementById('stats-grid');
  if (statsGrid) counterObserver.observe(statsGrid);
</script>

<style>
  .stats-section {
    padding: 6rem 2rem;
    background: linear-gradient(135deg, var(--ocean) 0%, #16213e 100%);
    color: white;
    position: relative;
    overflow: hidden;
  }

  .stats-section::before {
    content: '';
    position: absolute;
    width: 600px; height: 600px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255,217,61,0.08) 0%, transparent 70%);
    top: -200px; right: -200px;
  }

  .stats-grid {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 2rem;
    text-align: center;
  }

  .stat-item {
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.6s ease;
  }

  .stat-item:global(.visible) {
    opacity: 1;
    transform: translateY(0);
  }

  .stat-number {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 900;
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .stat-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.5);
  }

  @media (max-width: 768px) {
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
    }
  }
</style>
