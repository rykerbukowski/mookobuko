---
// WorldMap - Asia-focused animated travel map with coastlines
---

<section class="world-map-section" id="world-map">
  <div class="world-map-container">
    <span class="section-label reveal">The Journey</span>
    <h2 class="section-title reveal">Follow our route<br>around the world</h2>

    <div class="map-wrapper">
      <canvas id="travelMapCanvas"></canvas>

      <div class="map-hover-card" id="mapHoverCard">
        <div class="hover-card-image" id="hoverCardImage"></div>
        <div class="hover-card-content">
          <div class="hover-card-emoji" id="hoverCardEmoji"></div>
          <h3 class="hover-card-title" id="hoverCardTitle"></h3>
          <p class="hover-card-dates" id="hoverCardDates"></p>
          <p class="hover-card-desc" id="hoverCardDesc"></p>
          <span class="hover-card-status" id="hoverCardStatus"></span>
        </div>
      </div>

      <div class="map-legend">
        <span class="legend-item"><span class="legend-dot done"></span> Visited</span>
        <span class="legend-item"><span class="legend-dot current"></span> Currently here</span>
        <span class="legend-item"><span class="legend-dot upcoming"></span> Upcoming</span>
      </div>
    </div>
  </div>
</section>

<script is:inline>
document.addEventListener("DOMContentLoaded", function() {
  var canvas = document.getElementById("travelMapCanvas");
  if (!canvas) return;
  var ctx = canvas.getContext("2d");
  var wrapper = canvas.parentElement;
  var hoverCard = document.getElementById("mapHoverCard");

  // --- STOPS ---
  var stops = [
    { name: "Tokyo", emoji: "\uD83C\uDDEF\uD83C\uDDF5", lat: 35.68, lon: 139.69, dates: "Jan 6 - 13", status: "done", color: "#FF6B6B", slug: "/posts/tokyo", heroImage: "https://mookobuko.com/media/posts/6/IMG_9492.jpeg", description: "Onsens, ramen museums and Kewpie mayo." },
    { name: "Sapporo", emoji: "\uD83C\uDDEF\uD83C\uDDF5", lat: 43.06, lon: 141.35, dates: "Jan 14 - 20", status: "done", color: "#87CEEB", slug: "/posts/sapporo", heroImage: "https://mookobuko.com/media/posts/8/gallery/sapporo-downtown-snow-sapporo-star-building.jpg", description: "J-pow skiing, Ramen Alley and Sapporo Beer." },
    { name: "Taipei", emoji: "\uD83C\uDDF9\uD83C\uDDFC", lat: 25.03, lon: 121.56, dates: "Jan 21 - 31", status: "done", color: "#00C9A7", slug: "/posts/taiwan", heroImage: "https://mookobuko.com/media/posts/9/gallery/IMG_20260121_124606_00_343-2.jpg", description: "Bed bugs, bubble tea and Taipei 101." },
    { name: "Bangkok", emoji: "\uD83C\uDDF9\uD83C\uDDED", lat: 13.75, lon: 100.52, dates: "Feb 1 - 7", status: "done", color: "#FF3CAC", slug: "/posts/bangkok", heroImage: "https://mookobuko.com/media/posts/10/gallery/bangkok-traffic-sunset-mahanakhon-tower.jpg", description: "Street food, elephants and Muay Thai." },
    { name: "Koh Tao", emoji: "\uD83C\uDDF9\uD83C\uDDED", lat: 10.1, lon: 99.84, dates: "Feb 7 - 20", status: "done", color: "#FFD93D", slug: "/posts/islands", heroImage: "https://mookobuko.com/media/posts/11/gallery/koh-tao-yacht-sunset-dramatic.jpg", description: "Scuba diving and whale sharks." },
    { name: "Singapore", emoji: "\uD83C\uDDF8\uD83C\uDDEC", lat: 1.35, lon: 103.82, dates: "Feb 21 - 22", status: "done", color: "#7B2D8E", slug: "/posts/singapore", heroImage: "/media/posts/12/gallery/meg-marina-bay-sands-full.jpg", description: "48 hours of hawker centers and Marina Bay." },
    { name: "Philippines", emoji: "\uD83C\uDDF5\uD83C\uDDED", lat: 10.31, lon: 123.89, dates: "Feb 23 - Mar", status: "current", color: "#FFB88C", slug: null, heroImage: null, description: "Island hopping with Miles." },
    { name: "Bali", emoji: "\uD83C\uDDEE\uD83C\uDDE9", lat: -8.41, lon: 115.19, dates: "Upcoming", status: "upcoming", color: "#00C9A7", slug: null, heroImage: null, description: "Surf camps coming soon." }
  ];

  // --- COASTLINE DATA (simplified Asia polygons) ---
  var coastlines = {
    "china": [[108,18.5],[109,19.5],[109.5,21],[110,21.5],[111,21.5],[112,22],[113,22.5],[114,22.5],[115,23],[116,23.5],[117,24],[118,24.5],[119,25],[120,25.5],[121,26],[121.5,27],[122,28.5],[122,30],[121.5,31],[121,32],[120.5,33],[119.5,34],[119,35],[118.5,36],[118,37],[117.5,38],[117,39],[117.5,40],[119,40],[120,40],[121,41],[123,42],[124,43],[126,43],[128,44],[130,43],[131,43],[131,42],[130,42],[129,41],[128,39],[127,38],[126,37],[125,36],[124,35],[123,34],[121,33],[120,31.5],[121,30],[122,29],[121.5,27],[121,26],[120,25.5],[119,25],[118,24],[117,23.5],[116,23],[114.5,22.5],[113.5,22.5],[113,22],[112,21.5],[110,21],[109,20],[108,18.5]],
    "japan_honshu": [[130.5,31],[131,33],[132,33.5],[133,33.5],[134,34],[135,34.5],[136,35],[137,35],[138,35.5],[139,35.5],[140,36],[140.5,37],[140,38],[140,39],[140,40],[139.5,40.5],[140,41],[140.5,42],[139.5,42],[138,41],[137,37],[136.5,36],[136,35.5],[135.5,35],[135,34],[133.5,33.5],[132,33],[131,32],[130.5,31]],
    "japan_hokkaido": [[140,42],[141,43],[142,43],[143,43.5],[145,43.5],[145,44],[144.5,45],[143,45],[141.5,45],[140.5,43.5],[140,42.5],[140,42]],
    "korea": [[126,34],[126.5,35],[127,36],[127.5,37],[128,37.5],[129,37.5],[129.5,37],[129,36],[129,35.5],[129,35],[128.5,35],[127,34.5],[126,34]],
    "taiwan": [[120.5,22],[121,23],[121.5,24],[122,25.5],[121.5,25.5],[121,25],[120.5,24],[120,23],[120.5,22]],
    "vietnam": [[108,18.5],[107,17],[106.5,16.5],[106,16],[105.5,15],[108.5,12.5],[109,11.5],[108.5,11],[107.5,10.5],[106.5,10.5],[106,10],[105,9.5],[104.5,9],[103,8.5],[103,9.5],[102.5,10],[101.5,11],[100.5,12],[100,13]],
    "thailand": [[100,13],[100.5,14],[100.5,15.5],[100,16],[100,17],[100.5,18],[100.5,19],[101,20],[100.5,20.5],[99,19.5],[98.5,18],[98,16],[98.5,15],[99,14],[99.5,13],[100,12],[100,11],[99.5,10],[99,9],[98.5,8],[98,7.5],[98.5,7],[99,7],[99.5,7.5],[100,8],[100.5,8],[101,7],[101,6.5],[101.5,6],[102,6.5],[103,6],[103,5],[102.5,4],[102,3.5],[101.5,3],[101,2.5],[100.5,2],[100,1.5],[99.5,1]],
    "malay": [[99.5,1],[100,1.5],[100.5,2],[101,2.5],[101.5,3],[102,3.5],[102.5,4],[103,4.5],[103.5,4],[104,3],[104,2],[103.5,1.5],[103.5,1.3]],
    "sumatra": [[95,5.5],[96,5],[97,4],[98,3],[99,2],[100,1],[101,0],[102,-1],[103,-2],[104,-3],[105,-4],[105.5,-5],[106,-5.5],[105.5,-6],[105,-5.8],[104,-5],[103,-4],[102,-3],[101,-2],[100,-1],[99,0],[98,1],[97,2],[96,3.5],[95,5.5]],
    "borneo": [[109,1],[109.5,1.5],[110,2],[110.5,3],[111,3.5],[112,3],[113,3],[114,4],[115,4.5],[116,5],[117,6],[118,6.5],[118.5,6],[119,5.5],[118.5,5],[118,4.5],[117.5,4],[117.5,3],[118,2.5],[118.5,2],[118,1],[117.5,0.5],[117,0],[116.5,-0.5],[116,-1],[115,-2],[114,-2.5],[113,-2],[112,-1.5],[111,-1],[110,-0.5],[109.5,0],[109,0.5],[109,1]],
    "java": [[105,-6],[106,-6.2],[107,-6.5],[108,-6.8],[109,-7],[110,-7.2],[111,-7.5],[112,-7.5],[113,-7.8],[114,-8],[114.5,-8.2],[114,-8.5],[113,-8.2],[112,-7.8],[111,-7.8],[110,-7.5],[109,-7.3],[108,-7],[107,-6.8],[106,-6.5],[105,-6.2],[105,-6]],
    "luzon": [[120,14.5],[120.5,15],[121,16],[121.5,17],[122,18],[122,19],[121.5,18.5],[121,17],[120.5,16],[120,14.5]],
    "visayas": [[122,10],[123,10.5],[124,11],[124.5,11],[125,10.5],[124,10],[123.5,9.5],[123,9.5],[122.5,9.5],[122,10]],
    "mindanao": [[124,7],[125,7.5],[126,8],[126.5,9],[126,9.5],[125.5,10],[125,9.5],[124.5,9],[124,8],[124,7]],
    "sulawesi": [[120,-5],[120.5,-4],[121,-3],[122,-2],[122.5,-1.5],[123,-1],[124,-1.5],[124,-2],[123,-3],[122,-3.5],[121,-4.5],[120.5,-5.5],[120,-5]]
  };

  // --- SIZING ---
  var W, H, dpr;
  function resize() {
    dpr = window.devicePixelRatio || 1;
    var rect = wrapper.getBoundingClientRect();
    W = rect.width;
    H = Math.max(400, Math.min(600, W * 0.55));
    canvas.width = W * dpr;
    canvas.height = H * dpr;
    canvas.style.width = W + "px";
    canvas.style.height = H + "px";
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }
  resize();

  // --- PROJECTION (Asia crop) ---
  var LON_MIN = 93, LON_MAX = 148, LAT_MIN = -12, LAT_MAX = 48;

  function project(lat, lon) {
    var padX = 60, padY = 50;
    var x = padX + ((lon - LON_MIN) / (LON_MAX - LON_MIN)) * (W - padX * 2);
    var latRad = lat * Math.PI / 180;
    var mercN = Math.log(Math.tan(Math.PI / 4 + latRad / 2));
    var maxMerc = Math.log(Math.tan(Math.PI / 4 + (LAT_MAX * Math.PI / 180) / 2));
    var minMerc = Math.log(Math.tan(Math.PI / 4 + (LAT_MIN * Math.PI / 180) / 2));
    var y = padY + ((maxMerc - mercN) / (maxMerc - minMerc)) * (H - padY * 2);
    return { x: x, y: y };
  }

  // Project stops
  var projected = [];
  for (var i = 0; i < stops.length; i++) {
    var p = project(stops[i].lat, stops[i].lon);
    projected.push({ name: stops[i].name, emoji: stops[i].emoji, dates: stops[i].dates, status: stops[i].status, color: stops[i].color, slug: stops[i].slug, heroImage: stops[i].heroImage, description: stops[i].description, x: p.x, y: p.y });
  }

  // --- DRAW LAND ---
  function drawLand() {
    ctx.fillStyle = "#F5F0EB";
    ctx.fillRect(0, 0, W, H);

    // Ocean texture - subtle dots
    ctx.fillStyle = "rgba(0,0,0,0.02)";
    for (var gx = 0; gx < W; gx += 18) {
      for (var gy = 0; gy < H; gy += 18) {
        ctx.beginPath(); ctx.arc(gx, gy, 0.8, 0, Math.PI * 2); ctx.fill();
      }
    }

    // Draw each coastline polygon as filled land
    var keys = Object.keys(coastlines);
    for (var k = 0; k < keys.length; k++) {
      var poly = coastlines[keys[k]];
      ctx.beginPath();
      for (var j = 0; j < poly.length; j++) {
        var pt = project(poly[j][1], poly[j][0]);
        if (j === 0) ctx.moveTo(pt.x, pt.y);
        else ctx.lineTo(pt.x, pt.y);
      }
      ctx.closePath();
      ctx.fillStyle = "#E8E2DB";
      ctx.fill();
      ctx.strokeStyle = "#D5CEC5";
      ctx.lineWidth = 1;
      ctx.stroke();
    }

    // Equator
    var eq = project(0, LON_MIN);
    ctx.strokeStyle = "rgba(0,0,0,0.05)";
    ctx.lineWidth = 1;
    ctx.setLineDash([4, 8]);
    ctx.beginPath(); ctx.moveTo(0, eq.y); ctx.lineTo(W, eq.y); ctx.stroke();
    ctx.setLineDash([]);
  }

  // --- CURVED PATH ---
  function drawCurvedPath(p1, p2, progress, color) {
    var mx = (p1.x + p2.x) / 2, my = (p1.y + p2.y) / 2;
    var dist = Math.sqrt(Math.pow(p2.x - p1.x, 2) + Math.pow(p2.y - p1.y, 2));
    var cpx = mx, cpy = my - dist * 0.3;
    ctx.strokeStyle = color; ctx.lineWidth = 2; ctx.setLineDash([6, 4]);
    ctx.beginPath();
    var steps = Math.floor(100 * progress);
    for (var s = 0; s <= steps; s++) {
      var t = s / 100;
      var px = Math.pow(1-t,2)*p1.x + 2*(1-t)*t*cpx + Math.pow(t,2)*p2.x;
      var py = Math.pow(1-t,2)*p1.y + 2*(1-t)*t*cpy + Math.pow(t,2)*p2.y;
      if (s === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
    }
    ctx.stroke(); ctx.setLineDash([]);
    if (progress > 0 && progress < 1) {
      var at = progress;
      var ax = Math.pow(1-at,2)*p1.x + 2*(1-at)*at*cpx + Math.pow(at,2)*p2.x;
      var ay = Math.pow(1-at,2)*p1.y + 2*(1-at)*at*cpy + Math.pow(at,2)*p2.y;
      var at2 = Math.min(1, at + 0.01);
      var bx = Math.pow(1-at2,2)*p1.x + 2*(1-at2)*at2*cpx + Math.pow(at2,2)*p2.x;
      var by = Math.pow(1-at2,2)*p1.y + 2*(1-at2)*at2*cpy + Math.pow(at2,2)*p2.y;
      ctx.save(); ctx.translate(ax, ay); ctx.rotate(Math.atan2(by-ay, bx-ax));
      ctx.font = "16px sans-serif"; ctx.textAlign = "center"; ctx.textBaseline = "middle";
      ctx.fillText("\u2708\uFE0F", 0, 0); ctx.restore();
    }
  }

  // --- DRAW DOT ---
  function drawDot(stop, time) {
    var r = stop.status === "current" ? 8 : stop.status === "done" ? 6 : 5;
    if (stop.status === "current") {
      var pr = r + 6 + Math.sin(time * 3) * 4;
      ctx.beginPath(); ctx.arc(stop.x, stop.y, pr, 0, Math.PI * 2);
      ctx.fillStyle = stop.color + "30"; ctx.fill();
    }
    ctx.beginPath(); ctx.arc(stop.x, stop.y, r + 2, 0, Math.PI * 2); ctx.fillStyle = "white"; ctx.fill();
    ctx.shadowColor = "rgba(0,0,0,0.15)"; ctx.shadowBlur = 8; ctx.shadowOffsetY = 2;
    ctx.beginPath(); ctx.arc(stop.x, stop.y, r, 0, Math.PI * 2);
    ctx.fillStyle = stop.status === "upcoming" ? "rgba(0,0,0,0.15)" : stop.color; ctx.fill();
    ctx.shadowColor = "transparent"; ctx.shadowBlur = 0; ctx.shadowOffsetY = 0;
    ctx.font = '600 11px "DM Sans", sans-serif'; ctx.textAlign = "center"; ctx.textBaseline = "top";
    ctx.fillStyle = stop.status === "upcoming" ? "rgba(0,0,0,0.3)" : "rgba(0,0,0,0.7)";
    ctx.fillText(stop.name, stop.x, stop.y + r + 6);
    ctx.font = "14px sans-serif"; ctx.textBaseline = "bottom";
    ctx.fillText(stop.emoji, stop.x, stop.y - r - 4);
  }

  // --- ANIMATION ---
  var animProgress = 0, animStarted = false, animStartTime = 0, ANIM_MS = 1200;
  var hoveredStop = null;

  canvas.addEventListener("mousemove", function(e) {
    var rect = canvas.getBoundingClientRect();
    var mx = e.clientX - rect.left, my = e.clientY - rect.top;
    var found = null;
    for (var h = 0; h < projected.length; h++) {
      if (Math.sqrt(Math.pow(mx-projected[h].x,2)+Math.pow(my-projected[h].y,2)) < 25) { found = projected[h]; break; }
    }
    if (found !== hoveredStop) {
      hoveredStop = found;
      if (found) { canvas.style.cursor = found.slug ? "pointer" : "default"; showHoverCard(found); }
      else { canvas.style.cursor = "default"; hoverCard.classList.remove("visible"); }
    }
    if (hoveredStop) positionHoverCard(e.clientX, e.clientY);
  });
  canvas.addEventListener("mouseleave", function() { hoveredStop = null; hoverCard.classList.remove("visible"); canvas.style.cursor = "default"; });
  canvas.addEventListener("click", function() { if (hoveredStop && hoveredStop.slug) window.location.href = hoveredStop.slug; });
  canvas.addEventListener("touchstart", function(e) {
    var touch = e.touches[0]; var rect = canvas.getBoundingClientRect();
    var tx = touch.clientX - rect.left, ty = touch.clientY - rect.top;
    for (var ti = 0; ti < projected.length; ti++) {
      if (Math.sqrt(Math.pow(tx-projected[ti].x,2)+Math.pow(ty-projected[ti].y,2)) < 30) { if (projected[ti].slug) window.location.href = projected[ti].slug; break; }
    }
  });

  function showHoverCard(stop) {
    document.getElementById("hoverCardEmoji").textContent = stop.emoji;
    document.getElementById("hoverCardTitle").textContent = stop.name;
    document.getElementById("hoverCardDates").textContent = stop.dates;
    document.getElementById("hoverCardDesc").textContent = stop.description;
    var se = document.getElementById("hoverCardStatus");
    se.textContent = stop.status === "done" ? "Visited" : stop.status === "current" ? "Currently here" : "Upcoming";
    se.className = "hover-card-status status-" + stop.status;
    var ie = document.getElementById("hoverCardImage");
    if (stop.heroImage) { ie.style.backgroundImage = "url(" + stop.heroImage + ")"; ie.style.display = "block"; }
    else { ie.style.display = "none"; }
    if (stop.slug) hoverCard.classList.add("clickable"); else hoverCard.classList.remove("clickable");
    hoverCard.classList.add("visible");
  }
  function positionHoverCard(cx, cy) {
    var wr = wrapper.getBoundingClientRect();
    var left = cx - wr.left + 15, top = cy - wr.top - 20;
    if (left + 260 > wr.width) left = cx - wr.left - 260 - 15;
    if (top + 200 > wr.height) top = wr.height - 200 - 10;
    if (top < 0) top = 10;
    hoverCard.style.left = left + "px"; hoverCard.style.top = top + "px";
  }

  function draw(timestamp) {
    if (!animStarted) return;
    var elapsed = timestamp - animStartTime;
    var totalSeg = projected.length - 1;
    animProgress = Math.min(totalSeg, elapsed / ANIM_MS);
    ctx.clearRect(0, 0, W, H); drawLand();
    for (var d = 0; d < totalSeg; d++) {
      var seg = Math.max(0, Math.min(1, animProgress - d));
      if (seg > 0) {
        var f1 = projected[d].status === "done" || projected[d].status === "current";
        var f2 = projected[d+1].status === "done" || projected[d+1].status === "current";
        drawCurvedPath(projected[d], projected[d+1], seg, (f1 && f2) ? projected[d+1].color + "50" : "rgba(0,0,0,0.06)");
      }
    }
    var t = timestamp / 1000;
    for (var j = 0; j < projected.length; j++) { if (j <= Math.ceil(animProgress)) drawDot(projected[j], t); }
    if (elapsed < totalSeg * ANIM_MS + 500) requestAnimationFrame(draw);
    else { animProgress = totalSeg; drawFinal(timestamp); }
  }

  function drawFinal(timestamp) {
    ctx.clearRect(0, 0, W, H); drawLand();
    var totalSeg = projected.length - 1;
    for (var d = 0; d < totalSeg; d++) {
      var f1 = projected[d].status === "done" || projected[d].status === "current";
      var f2 = projected[d+1].status === "done" || projected[d+1].status === "current";
      drawCurvedPath(projected[d], projected[d+1], 1, (f1 && f2) ? projected[d+1].color + "50" : "rgba(0,0,0,0.06)");
    }
    var t = timestamp / 1000;
    for (var j = 0; j < projected.length; j++) drawDot(projected[j], t);
    requestAnimationFrame(drawFinal);
  }

  var obs = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting && !animStarted) { animStarted = true; animStartTime = performance.now(); requestAnimationFrame(draw); }
    });
  }, { threshold: 0.3 });
  obs.observe(canvas);

  var resizeTimer;
  window.addEventListener("resize", function() {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(function() {
      resize();
      for (var r = 0; r < stops.length; r++) { var rp = project(stops[r].lat, stops[r].lon); projected[r].x = rp.x; projected[r].y = rp.y; }
      if (animStarted) requestAnimationFrame(drawFinal);
    }, 150);
  });
});
</script>

<style>
  .world-map-section { padding: 6rem 2rem; background: var(--cream); position: relative; overflow: hidden; }
  .world-map-container { max-width: 1100px; margin: 0 auto; }
  .map-wrapper { position: relative; margin-top: 2rem; border-radius: 16px; overflow: hidden; box-shadow: 0 15px 60px rgba(0,0,0,0.08); }
  #travelMapCanvas { display: block; width: 100%; }
  .map-hover-card { position: absolute; width: 240px; background: white; border-radius: 12px; box-shadow: 0 12px 40px rgba(0,0,0,0.15); overflow: hidden; pointer-events: none; opacity: 0; transform: translateY(8px) scale(0.95); transition: opacity 0.2s, transform 0.2s; z-index: 100; }
  .map-hover-card.visible { opacity: 1; transform: translateY(0) scale(1); }
  .map-hover-card.clickable::after { content: 'Click to read \2192'; display: block; text-align: center; font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--coral); padding: 0.4rem; background: rgba(255,107,107,0.05); }
  .hover-card-image { height: 100px; background-size: cover; background-position: center; }
  .hover-card-content { padding: 0.75rem 1rem; }
  .hover-card-emoji { font-size: 1.2rem; float: right; }
  .hover-card-title { font-family: var(--font-display); font-size: 1.1rem; font-weight: 700; margin: 0 0 0.15rem 0; }
  .hover-card-dates { font-family: var(--font-mono); font-size: 0.65rem; color: rgba(0,0,0,0.4); letter-spacing: 0.05em; margin: 0 0 0.4rem 0; }
  .hover-card-desc { font-size: 0.78rem; color: rgba(0,0,0,0.6); line-height: 1.4; margin: 0 0 0.5rem 0; }
  .hover-card-status { display: inline-block; font-size: 0.6rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; padding: 0.15rem 0.5rem; border-radius: 20px; }
  .hover-card-status.status-done { background: var(--teal); color: white; }
