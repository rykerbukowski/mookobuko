---
// Travel stops with coordinates (lon/lat projected to simple Mercator)
// Each stop can link to a blog post
const stops = [
  {
    name: 'Seattle',
    emoji: '🇺🇸',
    lat: 47.6,
    lon: -122.33,
    dates: 'Home Base',
    status: 'done',
    color: '#FF6B6B',
    description: 'Where it all started — home base before the big adventure.',
  },
  {
    name: 'Tokyo',
    emoji: '🇯🇵',
    lat: 35.68,
    lon: 139.69,
    dates: 'Jan 6 – 13',
    status: 'done',
    color: '#FF6B6B',
    slug: '/posts/tokyo',
    heroImage: 'https://mookobuko.com/media/posts/6/IMG_9492.jpeg',
    description: 'Onsens, ramen museums & one-hour Kewpie mayo indoctrination.',
