---
// Route data - edit this to update your travel route!
const stops = [
  { emoji: '🇺🇸', name: 'Seattle', dates: 'Home Base', status: 'done', gradient: '#FF6B6B, #FF3CAC' },
  { emoji: '🇯🇵', name: 'Tokyo', dates: 'Jan 6 – 13', status: 'done', gradient: '#FFD93D, #FF6B6B', slug: '/posts/tokyo' },
  { emoji: '🇯🇵', name: 'Sapporo', dates: 'Jan 14 – 20', status: 'done', gradient: '#87CEEB, #00C9A7', slug: '/posts/sapporo' },
  { emoji: '🇹🇼', name: 'Taiwan', dates: 'Jan 21 – 31', status: 'done', gradient: '#00C9A7, #FFD93D', slug: '/posts/taiwan' },
  { emoji: '🇹🇭', name: 'Bangkok', dates: 'Feb 1 – 7', status: 'done', gradient: '#FF3CAC, #FFD93D', slug: '/posts/bangkok' },
  { emoji: '🇹🇭', name: 'The Islands', dates: 'Feb 7 – 20', status: 'done', gradient: '#FFD93D, #0a3d5e', slug: '/posts/islands' },
  { emoji: '🇸🇬', name: 'Singapore', dates: 'Feb 21 – 22', status: 'done', gradient: '#7B2D8E, #FF6B6B', slug: '/posts/singapore' },
  { emoji: '🇵🇭', name: 'Philippines', dates: 'Feb 22 – Mar 8', status: 'done', gradient: '#0891B2, #0EA5E9', slug: '/posts/philippines' },
  { emoji: '🇮🇩', name: 'Bali', dates: 'Mar 9 – 19', status: 'done', gradient: '#00C9A7, #87CEEB', slug: '/posts/bali' },
  { emoji: '🇲🇾', name: 'Borneo', dates: 'Mar 20 – 27', status: 'done', gradient: '#E11D48, #F59E0B', slug: '/posts/borneo-malaysia' },
  { emoji: '🇹🇼', name: 'Taiwan (II)', dates: 'Mar 26 – Apr 1', status: 'done', gradient: '#8B5CF6, #00C9A7' },
  { emoji: '🇻🇳', name: 'Vietnam', dates: 'Apr 1 – 17', status: 'done', gradient: '#F59E0B, #FF6B6B' },
  { emoji: '🇹🇭', name: 'Chiang Mai', dates: 'Apr 17 – 25', status: 'done', gradient: '#F97316, #FFD93D' },
  { emoji: '🇹🇭', name: 'Bangkok (II)', dates: 'Apr 25 – 28', status: 'done', gradient: '#FF3CAC, #FFD93D' },
  { emoji: '🇹🇭', name: 'Phuket', dates: 'Apr 28 – May 7', status: 'done', gradient: '#06B6D4, #00C9A7' },
  { emoji: '🇭🇰', name: 'Hong Kong', dates: 'May 7 – 9', status: 'done', gradient: '#DC2626, #FF6B6B' },
  { emoji: '🇯🇵', name: 'Tokyo (II)', dates: 'May 9 –', status: 'done', gradient: '#FF6B6B, #FFD93D' },
  { emoji: '🇯🇵', name: 'Onomichi', dates: 'Shimanami Kaido', status: 'done', gradient: '#A855F7, #FF6B6B' },
  { emoji: '🚲', name: 'Imabari', dates: '100 km biked', status: 'done', gradient: '#A855F7, #C6F135' },
  { emoji: '🇰🇷', name: 'Seoul', dates: 'Four Rivers start', status: 'done', gradient: '#3B82F6, #00C9A7' },
  { emoji: '🚲', name: 'Busan', dates: '600 km biked', status: 'done', gradient: '#06B6D4, #C6F135' },
  { emoji: '🇹🇷', name: 'Istanbul', dates: 'East meets West', status: 'done', gradient: '#EF4444, #F59E0B' },
  { emoji: '🇬🇪', name: 'Tbilisi', dates: 'Now', status: 'current', gradient: '#F59E0B, #FF6B6B' },
  { emoji: '🇦🇲', name: 'Yerevan', dates: 'Up next', status: 'upcoming', gradient: '#8B5CF6, #C6F135' },
  { emoji: '🌍', name: '& more...', dates: 'The adventure continues', status: 'upcoming', gradient: '#C6F135, #00C9A7' },
];

const statusMap: Record<string, { label: string; class: string }> = {
  done: { label: '✓ Done', class: 'status-done' },
  current: { label: '● Now', class: 'status-current' },
  upcoming: { label: 'Soon', class: 'status-upcoming' },
};
---

<section class="route-section" id="route">
  <div class="route-container">
    <span class="section-label reveal">The Route</span>
    <h2 class="section-title reveal">Where we've been<br>& where we're going</h2>
    <div class="route-map">
      {stops.map((stop, i) => (
        stop.slug ? (
          <a href={stop.slug} class="route-stop has-link">
            <div class="stop-dot" style={`background:linear-gradient(135deg,${stop.gradient});`}>
              {stop.emoji}
            </div>
            {i < stops.length - 1 && <div class="stop-line" />}
            <div class="stop-name">{stop.name}</div>
            <div class="stop-dates">{stop.dates}</div>
            <span class={`stop-status ${statusMap[stop.status].class}`}>
              {statusMap[stop.status].label}
            </span>
          </a>
        ) : (
          <div class="route-stop">
            <div class="stop-dot" style={`background:linear-gradient(135deg,${stop.gradient});`}>
              {stop.emoji}
            </div>
            {i < stops.length - 1 && <div class="stop-line" />}
            <div class="stop-name">{stop.name}</div>
            <div class="stop-dates">{stop.dates}</div>
            <span class={`stop-status ${statusMap[stop.status].class}`}>
              {statusMap[stop.status].label}
            </span>
          </div>
        )
      ))}
    </div>
  </div>
</section>

<style>
  .route-section {
    padding: 6rem 2rem;
    background: var(--cream);
    position: relative;
    overflow: hidden;
  }

  .route-section::before {
    content: '';
    position: absolute;
    top: -100px; left: -100px;
    width: 400px; height: 400px;
    background: radial-gradient(circle, rgba(255,107,107,0.08) 0%, transparent 70%);
    border-radius: 50%;
  }

  .route-container { max-width: 1200px; margin: 0 auto; }

  .route-map {
    display: flex;
    gap: 0;
    overflow-x: auto;
    padding: 3rem 0;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .route-map::-webkit-scrollbar { display: none; }

  .route-stop {
    flex: 0 0 280px;
    scroll-snap-align: center;
    position: relative;
    padding: 0 1rem;
    text-align: center;
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .route-stop:hover { transform: translateY(-10px); }

  a.route-stop {
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }

  a.route-stop .stop-name {
    transition: color 0.2s;
  }

  a.route-stop:hover .stop-name {
    color: var(--coral);
  }

  .stop-dot {
    width: 48px; height: 48px;
    border-radius: 50%;
    margin: 0 auto 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    position: relative;
    z-index: 2;
    box-shadow: 0 4px 20px rgba(0,0,0,0.15);
    transition: transform 0.3s, box-shadow 0.3s;
  }

  .route-stop:hover .stop-dot {
    transform: scale(1.2);
    box-shadow: 0 8px 30px rgba(0,0,0,0.25);
  }

  .stop-line {
    position: absolute;
    top: 24px;
    left: calc(50% + 24px);
    width: calc(100% - 48px);
    height: 3px;
    background: linear-gradient(90deg, var(--teal), var(--coral));
    opacity: 0.3;
    z-index: 1;
  }

  .stop-name {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
  }

  .stop-dates {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: rgba(0,0,0,0.4);
    letter-spacing: 0.05em;
  }

  .stop-status {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    padding: 0.2rem 0.6rem;
    border-radius: 20px;
  }

  .status-done { background: var(--teal); color: white; }
  .status-current { background: var(--coral); color: white; animation: pulse 2s infinite; }
  .status-upcoming { background: rgba(0,0,0,0.08); color: rgba(0,0,0,0.4); }

  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(255,107,107,0.4); }
    50% { box-shadow: 0 0 0 10px rgba(255,107,107,0); }
  }

  @media (max-width: 768px) {
    .route-stop { flex: 0 0 200px; }
  }
</style>
