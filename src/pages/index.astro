---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import RouteMap from '../components/RouteMap.astro';
import Ticker from '../components/Ticker.astro';
import StoryCard from '../components/StoryCard.astro';
import Stats from '../components/Stats.astro';
import About from '../components/About.astro';
import WorldMap from '../components/WorldMap.astro';
import { getCollection } from 'astro:content';

// Get all published posts, sorted by date (newest first)
const posts = (await getCollection('posts', ({ data }) => data.status === 'published'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const bgColors = ['#FFF0F0', '#F0FFF4', '#FFF8E6', '#F0F4FF', '#FFF0FB'];
---

<BaseLayout>
  <Hero />
  <RouteMap />
  <WorldMap />
  <Ticker />

  <section class="stories-section" id="stories">
    <div class="stories-header">
      <span class="section-label reveal">Our Stories</span>
      <h2 class="section-title reveal">Tales from the road</h2>
    </div>

    {posts.map((post, i) => (
      <StoryCard
        number={String(i + 1).padStart(2, '0')}
        title={post.data.subtitle || post.data.title}
        location={post.data.location}
        locationColor={post.data.heroColor}
        date={post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        excerpt={post.data.excerpt}
        heroImage={post.data.heroImage}
        heroColor={post.data.heroColor}
        tags={post.data.tags}
        slug={post.id}
        bgColor={bgColors[i % bgColors.length]}
      />
    ))}
  </section>

  <Stats />
  <About />
</BaseLayout>

<style>
  .stories-section {
    padding: 4rem 0;
  }

  .stories-header {
    padding: 0 2rem 3rem;
    max-width: 1200px;
    margin: 0 auto;
  }
</style>
