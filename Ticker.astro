---

<section class="ticker-section">
  <div class="ticker" id="factTicker"></div>
</section>

<script is:inline define:vars={{ facts }}>
  (function() {
    // Shuffle facts randomly on each page load
    var shuffled = facts.slice();
    for (var i = shuffled.length - 1; i > 0; i--) {
      var j = Math.floor(Math.random() * (i + 1));
      var tmp = shuffled[i];
      shuffled[i] = shuffled[j];
      shuffled[j] = tmp;
    }

    var ticker = document.getElementById('factTicker');
    if (!ticker) return;

    // Duplicate the list so the scroll loops seamlessly
    var doubled = shuffled.concat(shuffled);
    doubled.forEach(function(fact) {
      var item = document.createElement('div');
      item.className = 'ticker-item';
      var em = document.createElement('span');
      em.className = 'emoji';
      em.textContent = fact.emoji;
      item.appendChild(em);
      item.appendChild(document.createTextNode(' ' + fact.text));
      ticker.appendChild(item);
    });
  })();
</script>

<style>
  .ticker-section {
    padding: 2rem 0;
    background: var(--ink);
    overflow: hidden;
  }

  .ticker {
    display: flex;
    animation: ticker 60s linear infinite;
    white-space: nowrap;
  }

  .ticker-item {
    flex-shrink: 0;
    padding: 0 3rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .emoji { font-size: 1.3rem; }

  .ticker-item:nth-child(odd) { color: var(--sunflower); }
  .ticker-item:nth-child(even) { color: var(--teal); }

  @keyframes ticker {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
</style>
